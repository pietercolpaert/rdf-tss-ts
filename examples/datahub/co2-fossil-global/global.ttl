@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prefix: <http://qudt.org/vocab/prefix/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .

# data/global.csv of the data package "Global CO2 Emissions from Fossil Fuels since 1750" on GitHub (https://github.com/datasets/co2-fossil-global).
# This document only describes the CSV file: the rows are read from where the data package
# publishes them. Written by scripts/datahub.ts.
#
# The file has one row per year, without gaps, so the time of a row is its step on a
# time grid of P1Y from 1750-01-01: the source has no step field, and its Year column
# is not read as the time.
<#source>
    a tss:CSVSource ;
    rdfs:label "CO₂ emissions from fossil fuels since 1750"@en ;
    dcterms:source <https://github.com/datasets/co2-fossil-global> ;
    dcterms:license <http://opendatacommons.org/licenses/pddl/> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/datasets/co2-fossil-global/main/datapackage.json> ;
    tss:from "1750-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://raw.githubusercontent.com/datasets/co2-fossil-global/main/data/global.csv> ;
    tss:timeBase "1750-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P1Y"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#date>,
        <#total>,
        <#gas-fuel>,
        <#liquid-fuel>,
        <#solid-fuel>,
        <#cement>,
        <#gas-flaring>,
        <#per-capita> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:ContextField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#date>
    a tss:ContextField ;
    rdfs:label "Year as written in the file"@en ;
    rdfs:comment "A date without a time of day and a timezone, so it is not the time of the row."@en ;
    tss:columnName "Year" ;
    tss:datatype xsd:gYear .

<#total>
    a tss:ValueField ;
    rdfs:label "Total"@en ;
    rdfs:comment "Total carbon emissions from fossil fuel consumption and cement production (million metric tons of C)"@en ;
    tss:columnName "Total" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MegaTONNE .

<#gas-fuel>
    a tss:ValueField ;
    rdfs:label "Gas Fuel"@en ;
    rdfs:comment "Carbon emissions from gas fuel consumption"@en ;
    tss:columnName "Gas Fuel" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MegaTONNE .

<#liquid-fuel>
    a tss:ValueField ;
    rdfs:label "Liquid Fuel"@en ;
    rdfs:comment "Carbon emissions from liquid fuel consumption"@en ;
    tss:columnName "Liquid Fuel" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MegaTONNE .

<#solid-fuel>
    a tss:ValueField ;
    rdfs:label "Solid Fuel"@en ;
    rdfs:comment "Carbon emissions from solid fuel consumption"@en ;
    tss:columnName "Solid Fuel" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MegaTONNE .

<#cement>
    a tss:ValueField ;
    rdfs:label "Cement"@en ;
    rdfs:comment "Carbon emissions from cement production"@en ;
    tss:columnName "Cement" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MegaTONNE .

<#gas-flaring>
    a tss:ValueField ;
    rdfs:label "Gas Flaring"@en ;
    rdfs:comment "Carbon emissions from gas flaring"@en ;
    tss:columnName "Gas Flaring" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MegaTONNE .

<#per-capita>
    a tss:ValueField ;
    rdfs:label "Per Capita"@en ;
    rdfs:comment "Per capita carbon emissions (metric tons of carbon; after 1949 only)"@en ;
    tss:columnName "Per Capita" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:TONNE .
