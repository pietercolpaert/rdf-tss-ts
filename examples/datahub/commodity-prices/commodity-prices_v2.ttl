    qudt:hasFactorUnit [ a qudt:FactorUnit ; qudt:exponent 1 ; qudt:hasUnit <#CentiCCY_USD> ],
        [ a qudt:FactorUnit ; qudt:exponent -1 ; qudt:hasUnit unit:LB ] ;
    rdfs:label "US cent per pound"@en ;
    qudt:symbol "¢/lb" .

