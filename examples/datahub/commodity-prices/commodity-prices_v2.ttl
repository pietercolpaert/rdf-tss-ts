# Units that QUDT does not have, made of QUDT units. A unit with a currency states no conversion
# multiplier: an exchange rate changes over time.
<#CentiCCY_USD>
    a qudt:Unit ;
    qudt:scalingOf unit:CCY_USD ;
    qudt:prefix prefix:Centi ;
    rdfs:label "US cent"@en ;
    qudt:symbol "¢" .

<#CentiUSD-PER-KiloGM>
    a qudt:DerivedUnit, qudt:Unit ;
    qudt:hasFactorUnit [ a qudt:FactorUnit ; qudt:exponent 1 ; qudt:hasUnit <#CentiCCY_USD> ],
        [ a qudt:FactorUnit ; qudt:exponent -1 ; qudt:hasUnit unit:KiloGM ] ;
    rdfs:label "US cent per kilogram"@en ;
    qudt:symbol "¢/kg" .

<#CentiUSD-PER-LB>
