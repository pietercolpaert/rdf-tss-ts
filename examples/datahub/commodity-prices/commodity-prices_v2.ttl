@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prefix: <http://qudt.org/vocab/prefix/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .

# data/commodity-prices_v2.csv of the data package "Commodity prices" on GitHub (https://github.com/datasets/commodity-prices).
# This document only describes the CSV file: the rows are read from where the data package
# publishes them. Written by scripts/datahub.ts.
#
# The file has one row per month, without gaps, so the time of a row is its step on a
# time grid of P1M from 1990-01-01: the source has no step field, and its Date column
# is not read as the time.
<#source>
    a tss:CSVSource ;
    rdfs:label "63 commodity prices and indices, monthly"@en ;
    rdfs:comment "Updated monthly commodity prices and indices, with 2016 as the base year (2016=100)."@en ;
    dcterms:source <https://github.com/datasets/commodity-prices> ;
    dcterms:license <http://opendatacommons.org/licenses/pddl/> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/datasets/commodity-prices/main/datapackage.json> ;
    tss:from "1990-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://raw.githubusercontent.com/datasets/commodity-prices/main/data/commodity-prices_v2.csv> ;
    tss:timeBase "1990-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P1M"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#date>,
        <#all-commodity-price-index>,
        <#non-fuel-price-index>,
        <#food-and-beverage-price-index>,
        <#food-price-index>,
        <#beverage-price-index>,
        <#industrial-inputs-price-index>,
        <#agricultural-raw-materials-index>,
        <#metals-price-index>,
        <#fuel-energy-index>,
        <#crude-oil-petroleum>,
        <#aluminum>,
        <#bananas>,
        <#barley>,
        <#beef>,
        <#coal>,
        <#cocoa-beans>,
        <#coffee-other-mild-arabicas>,
        <#coffee-robusta>,
        <#rapeseed-oil>,
        <#copper>,
        <#cotton>,
        <#fishmeal>,
        <#groundnuts-peanuts>,
        <#hides>,
        <#china-import-iron-ore-fines-62-fe-spot>,
        <#lamb>,
        <#lead>,
        <#soft-logs>,
        <#hard-logs>,
        <#maize-corn>,
        <#natural-gas-russian-natural-gas-border-price-in-germany>,
        <#natural-gas-indonesian-liquefied-natural-gas-in-japan>,
        <#natural-gas-spot-price-at-the-henry-hub-terminal-in-louisiana>,
        <#nickel>,
        <#crude-oil-petroleum-simple-average-of-three-spot-prices>,
        <#crude-oil-petroleum-dated-brent-light-blend>,
        <#oil-dubai>,
        <#crude-oil-petroleum-west-texas-intermediate-40-api>,
        <#olive-oil>,
        <#oranges>,
        <#palm-oil>,
        <#swine-pork>,
        <#poultry-chicken>,
        <#rice>,
        <#rubber>,
        <#fish-salmon>,
        <#hard-sawnwood>,
        <#soft-sawnwood>,
        <#shrimp>,
        <#soybean-meal>,
        <#soybean-oil>,
        <#soybeans>,
        <#sugar-european-import-price>,
        <#sugar-free-market>,
        <#sugar-u-s-import-price>,
        <#sunflower-oil>,
        <#tea>,
        <#tin>,
        <#uranium>,
        <#wheat>,
        <#wool-coarse>,
        <#wool-fine>,
        <#zinc> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:MetaField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#date>
    a tss:MetaField ;
    rdfs:label "Date as written in the file"@en ;
    rdfs:comment "A date without a time of day and a timezone, so it is not the time of the row."@en ;
    tss:columnName "Date" ;
    tss:datatype xsd:date .

<#all-commodity-price-index>
    a tss:ValueField ;
    rdfs:label "All Commodity Price Index"@en ;
    rdfs:comment "includes both Fuel and Non-Fuel Price Indices"@en ;
    tss:columnName "All Commodity Price Index" ;
    tss:datatype xsd:decimal .

<#non-fuel-price-index>
    a tss:ValueField ;
    rdfs:label "Non-Fuel Price Index"@en ;
    rdfs:comment "includes Food and Beverages and Industrial Inputs Price Indices"@en ;
    tss:columnName "Non-Fuel Price Index" ;
    tss:datatype xsd:decimal .

<#food-and-beverage-price-index>
    a tss:ValueField ;
    rdfs:label "Food and Beverage Price Index"@en ;
    rdfs:comment "includes Food and Beverage Price Indices"@en ;
    tss:columnName "Food and Beverage Price Index" ;
    tss:datatype xsd:decimal .

<#food-price-index>
    a tss:ValueField ;
    rdfs:label "Food Price Index"@en ;
    rdfs:comment "includes Cereal, Vegetable Oils, Meat, Seafood, Sugar, Bananas, and Oranges Price Indices"@en ;
    tss:columnName "Food Price Index" ;
    tss:datatype xsd:decimal .

<#beverage-price-index>
    a tss:ValueField ;
    rdfs:label "Beverage Price Index"@en ;
    rdfs:comment "includes Coffee, Tea, and Cocoa"@en ;
    tss:columnName "Beverage Price Index" ;
    tss:datatype xsd:decimal .

<#industrial-inputs-price-index>
    a tss:ValueField ;
    rdfs:label "Industrial Inputs Price Index"@en ;
    rdfs:comment "includes Agricultural Raw Materials and Metals Price Indices"@en ;
    tss:columnName "Industrial Inputs Price Index" ;
    tss:datatype xsd:decimal .

<#agricultural-raw-materials-index>
    a tss:ValueField ;
    rdfs:label "Agricultural Raw Materials Index"@en ;
    rdfs:comment "includes Timber, Cotton, Wool, Rubber, and Hides Price Indices"@en ;
    tss:columnName "Agricultural Raw Materials Index" ;
    tss:datatype xsd:decimal .

<#metals-price-index>
    a tss:ValueField ;
    rdfs:label "Metals Price Index"@en ;
    rdfs:comment "includes Copper, Aluminum, Iron Ore, Tin, Nickel, Zinc, Lead, and Uranium Price Indices"@en ;
    tss:columnName "Metals Price Index" ;
    tss:datatype xsd:decimal .

<#fuel-energy-index>
    a tss:ValueField ;
    rdfs:label "Fuel Energy Index"@en ;
    rdfs:comment "includes Crude oil (petroleum), Natural Gas, and Coal Price Indices"@en ;
    tss:columnName "Fuel Energy Index" ;
    tss:datatype xsd:decimal .

<#crude-oil-petroleum>
    a tss:ValueField ;
    rdfs:label "Crude Oil petroleum"@en ;
    rdfs:comment "simple average of three spot prices Dated Brent, West Texas Intermediate and the Dubai Fateh"@en ;
    tss:columnName "Crude Oil petroleum" ;
    tss:datatype xsd:decimal .

<#aluminum>
    a tss:ValueField ;
    rdfs:label "Aluminum"@en ;
    rdfs:comment "99.5% minimum purity, USD per metric ton"@en ;
    tss:columnName "Aluminum" ;
    tss:datatype xsd:decimal ;
    tss:unit <#USD-PER-TONNE> .

<#bananas>
    a tss:ValueField ;
