@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prefix: <http://qudt.org/vocab/prefix/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .

# data/year.csv of the data package "Gross Domestic Product of the United States (US GDP)" on GitHub (https://github.com/datasets/gdp-us).
# This document only describes the CSV file: the rows are read from where the data package
# publishes them. Written by scripts/datahub.ts.
#
# The file has one row per year, without gaps, so the time of a row is its step on a
# time grid of P1Y from 1929-01-01: the source has no step field, and its date column
# is not read as the time.
<#source>
    a tss:CSVSource ;
    rdfs:label "US GDP, yearly"@en ;
    dcterms:source <https://github.com/datasets/gdp-us> ;
    dcterms:license <http://opendatacommons.org/licenses/pddl/> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/datasets/gdp-us/main/datapackage.json> ;
    tss:from "1929-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://raw.githubusercontent.com/datasets/gdp-us/main/data/year.csv> ;
    tss:timeBase "1929-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P1Y"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#date>,
        <#level-current>,
        <#level-chained>,
        <#change-current>,
        <#change-chained> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:ContextField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#date>
    a tss:ContextField ;
    rdfs:label "date as written in the file"@en ;
    rdfs:comment "A date without a time of day and a timezone, so it is not the time of the row."@en ;
    tss:columnName "date" ;
    tss:datatype xsd:gYear .

<#level-current>
    a tss:ValueField ;
    rdfs:label "level-current"@en ;
    rdfs:comment "GDP in billions of current dollars"@en ;
    tss:columnName "level-current" ;
    tss:datatype xsd:decimal ;
    tss:unit <#GigaCCY_USD> .

<#level-chained>
    a tss:ValueField ;
    rdfs:label "level-chained"@en ;
    rdfs:comment "GDP in billions of chained 2009 dollars"@en ;
    tss:columnName "level-chained" ;
    tss:datatype xsd:decimal ;
    tss:unit <#GigaCCY_USD> .

<#change-current>
    a tss:ValueField ;
    rdfs:label "change-current"@en ;
    rdfs:comment "GDP percent change based on current dollars"@en ;
    tss:columnName "change-current" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:PERCENT .

<#change-chained>
    a tss:ValueField ;
    rdfs:label "change-chained"@en ;
    rdfs:comment "GDP percent change based on chained 2009 dollars"@en ;
    tss:columnName "change-chained" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:PERCENT .

# Units that QUDT does not have, made of QUDT units. A unit with a currency states no conversion
# multiplier: an exchange rate changes over time.
<#GigaCCY_USD>
    a qudt:Unit ;
    qudt:scalingOf unit:CCY_USD ;
    qudt:prefix prefix:Giga ;
    rdfs:label "billion US dollars"@en ;
    qudt:symbol "$bn" .
