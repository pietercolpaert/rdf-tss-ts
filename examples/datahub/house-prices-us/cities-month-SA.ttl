@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prefix: <http://qudt.org/vocab/prefix/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .

# data/cities-month-SA.csv of the data package "US House Price Index (Case-Shiller)" on GitHub (https://github.com/datasets/house-prices-us).
# This document only describes the CSV file: the rows are read from where the data package
# publishes them. Written by scripts/datahub.ts.
#
# The file has one row per month, without gaps, so the time of a row is its step on a
# time grid of P1M from 1987-01-01: the source has no step field, and its Date column
# is not read as the time.
<#source>
    a tss:CSVSource ;
    rdfs:label "US home price index of 20 cities, seasonally adjusted"@en ;
    rdfs:comment "Case-Shiller US home price index levels at national and city level. Monthly. Seasonally adjusted."@en ;
    dcterms:source <https://github.com/datasets/house-prices-us> ;
    dcterms:license <https://opendatacommons.org/licenses/pddl/> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/datasets/house-prices-us/main/datapackage.json> ;
    tss:from "1987-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://raw.githubusercontent.com/datasets/house-prices-us/main/data/cities-month-SA.csv> ;
    tss:timeBase "1987-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P1M"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#date>,
        <#az-phoenix>,
        <#ca-los-angeles>,
        <#ca-san-diego>,
        <#ca-san-francisco>,
        <#co-denver>,
        <#dc-washington>,
        <#fl-miami>,
        <#fl-tampa>,
        <#ga-atlanta>,
        <#il-chicago>,
        <#ma-boston>,
        <#mi-detroit>,
        <#mn-minneapolis>,
        <#nc-charlotte>,
        <#nv-las-vegas>,
        <#ny-new-york>,
        <#oh-cleveland>,
        <#or-portland>,
        <#tx-dallas>,
        <#wa-seattle>,
        <#composite-10>,
        <#composite-20>,
        <#national-us> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:ContextField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#date>
    a tss:ContextField ;
    rdfs:label "Date as written in the file"@en ;
    rdfs:comment "A date without a time of day and a timezone, so it is not the time of the row."@en ;
    tss:columnName "Date" ;
    tss:datatype xsd:date .

<#az-phoenix>
    a tss:ValueField ;
    rdfs:label "AZ-Phoenix"@en ;
    rdfs:comment "Case-Shiller home price index for Phoenix, Arizona (seasonally adjusted)."@en ;
    tss:columnName "AZ-Phoenix" ;
    tss:datatype xsd:decimal .

<#ca-los-angeles>
    a tss:ValueField ;
    rdfs:label "CA-Los Angeles"@en ;
    rdfs:comment "Case-Shiller home price index for Los Angeles, California (seasonally adjusted)."@en ;
    tss:columnName "CA-Los Angeles" ;
    tss:datatype xsd:decimal .

<#ca-san-diego>
    a tss:ValueField ;
    rdfs:label "CA-San Diego"@en ;
    rdfs:comment "Case-Shiller home price index for San Diego, California (seasonally adjusted). Blank for months before the series begins."@en ;
    tss:columnName "CA-San Diego" ;
    tss:datatype xsd:decimal .

<#ca-san-francisco>
    a tss:ValueField ;
    rdfs:label "CA-San Francisco"@en ;
    rdfs:comment "Case-Shiller home price index for San Francisco, California (seasonally adjusted)."@en ;
    tss:columnName "CA-San Francisco" ;
    tss:datatype xsd:decimal .

<#co-denver>
    a tss:ValueField ;
    rdfs:label "CO-Denver"@en ;
    rdfs:comment "Case-Shiller home price index for Denver, Colorado (seasonally adjusted)."@en ;
    tss:columnName "CO-Denver" ;
    tss:datatype xsd:decimal .

<#dc-washington>
    a tss:ValueField ;
    rdfs:label "DC-Washington"@en ;
    rdfs:comment "Case-Shiller home price index for Washington, DC (seasonally adjusted)."@en ;
    tss:columnName "DC-Washington" ;
    tss:datatype xsd:decimal .

<#fl-miami>
    a tss:ValueField ;
    rdfs:label "FL-Miami"@en ;
    rdfs:comment "Case-Shiller home price index for Miami, Florida (seasonally adjusted)."@en ;
    tss:columnName "FL-Miami" ;
    tss:datatype xsd:decimal .

<#fl-tampa>
    a tss:ValueField ;
    rdfs:label "FL-Tampa"@en ;
    rdfs:comment "Case-Shiller home price index for Tampa, Florida (seasonally adjusted)."@en ;
