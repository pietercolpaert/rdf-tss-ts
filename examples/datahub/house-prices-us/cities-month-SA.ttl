<#nc-charlotte>
    a tss:ValueField ;
    rdfs:label "NC-Charlotte"@en ;
    rdfs:comment "Case-Shiller home price index for Charlotte, North Carolina (seasonally adjusted)."@en ;
    tss:columnName "NC-Charlotte" ;
