@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prefix: <http://qudt.org/vocab/prefix/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .

# data/national-month.csv of the data package "US House Price Index (Case-Shiller)" on GitHub (https://github.com/datasets/house-prices-us).
# This document only describes the CSV file: the rows are read from where the data package
# publishes them. Written by scripts/datahub.ts.
#
# The file has one row per month, without gaps, so the time of a row is its step on a
# time grid of P1M from 1975-01-01: the source has no step field, and its Date column
# is not read as the time.
<#source>
    a tss:CSVSource ;
    rdfs:label "US national home price index (Case-Shiller)"@en ;
    rdfs:comment "United States National Housing Price Indices. Monthly data from 1975 onwards, with both seasonally adjusted and not seasonally adjusted series."@en ;
    dcterms:source <https://github.com/datasets/house-prices-us> ;
    dcterms:license <https://opendatacommons.org/licenses/pddl/> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/datasets/house-prices-us/main/datapackage.json> ;
    tss:from "1975-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://raw.githubusercontent.com/datasets/house-prices-us/main/data/national-month.csv> ;
    tss:timeBase "1975-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P1M"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#date>,
        <#national-us>,
        <#national-us-sa> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:ContextField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#date>
    a tss:ContextField ;
    rdfs:label "Date as written in the file"@en ;
    rdfs:comment "A date without a time of day and a timezone, so it is not the time of the row."@en ;
    tss:columnName "Date" ;
    tss:datatype xsd:date .

<#national-us>
    a tss:ValueField ;
    rdfs:label "National-US"@en ;
    rdfs:comment "S&P/Case-Shiller U.S. National Home Price Index, not seasonally adjusted."@en ;
    tss:columnName "National-US" ;
    tss:datatype xsd:decimal .

<#national-us-sa>
    a tss:ValueField ;
    rdfs:label "National-US-SA"@en ;
    rdfs:comment "S&P/Case-Shiller U.S. National Home Price Index, seasonally adjusted."@en ;
    tss:columnName "National-US-SA" ;
    tss:datatype xsd:decimal .
