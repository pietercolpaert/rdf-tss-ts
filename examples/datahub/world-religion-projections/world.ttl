@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix prefix: <http://qudt.org/vocab/prefix/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .

# world.csv of the data package "World Religion Projections" on GitHub (https://github.com/datasets/world-religion-projections).
# This document only describes the CSV file: the rows are read from where the data package
# publishes them. Written by scripts/datahub.ts.
#
# The file has one row per 10 years, without gaps, so the time of a row is its step on a
# time grid of P10Y from 2010-01-01: the source has no step field, and its Year column
# is not read as the time.
<#source>
    a tss:CSVSource ;
    rdfs:label "World religion projections, 2010 to 2050"@en ;
    rdfs:comment "World-level population totals for the three largest religious groups (Christians, Muslims, and Hindus) for 2010 to 2050 in 10-year increments."@en ;
    dcterms:source <https://github.com/datasets/world-religion-projections> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/datasets/world-religion-projections/main/datapackage.json> ;
    tss:from "2010-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://raw.githubusercontent.com/datasets/world-religion-projections/main/world.csv> ;
    tss:timeBase "2010-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P10Y"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#date>,
        <#christians>,
        <#muslims>,
        <#hindus> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:MetaField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#date>
    a tss:MetaField ;
    rdfs:label "Year as written in the file"@en ;
    rdfs:comment "A date without a time of day and a timezone, so it is not the time of the row."@en ;
    tss:columnName "Year" ;
    tss:datatype xsd:gYear .

<#christians>
    a tss:ValueField ;
    rdfs:label "Christians"@en ;
    rdfs:comment "Estimated global number of Christians."@en ;
    tss:columnName "Christians" ;
    tss:datatype xsd:integer ;
    tss:unit unit:NUM .

<#muslims>
    a tss:ValueField ;
    rdfs:label "Muslims"@en ;
    rdfs:comment "Estimated global number of Muslims."@en ;
    tss:columnName "Muslims" ;
    tss:datatype xsd:integer ;
    tss:unit unit:NUM .

<#hindus>
    a tss:ValueField ;
    rdfs:label "Hindus"@en ;
    rdfs:comment "Estimated global number of Hindus."@en ;
    tss:columnName "Hindus" ;
    tss:datatype xsd:integer ;
    tss:unit unit:NUM .
