@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Deaths, Belgium: the series W.T.NR.BE of the Eurostat dataset
# demo_r_mwk_ts, as SDMX-CSV from the dissemination API of Eurostat. This document only
# describes it: the rows are read from Eurostat. Written by scripts/eurostat.ts.
#
# The file has one row per week, without gaps, so the time of a row is the start of its
# week: its step on a time grid of P7D from 2000-01-03. The TIME_PERIOD column is
# not read as the time, and the other columns of the file are not described.
<#source>
    a tss:CSVSource ;
    rdfs:label "Deaths, Belgium"@en ;
    rdfs:comment "The number of deaths in a week (ISO 8601 weeks, Monday to Sunday), all sexes."@en ;
    dcterms:publisher <https://ec.europa.eu/eurostat> ;
    dcterms:source <https://ec.europa.eu/eurostat/databrowser/view/demo_r_mwk_ts/default/table> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    tss:from "2000-01-03T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/demo_r_mwk_ts/W.T.NR.BE?format=SDMX-CSV> ;
    tss:timeBase "2000-01-03T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P7D"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#period>,
        <#value>,
        <#flag> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:ContextField ;
    rdfs:label "Start of the period"@en ;
    tss:datatype xsd:dateTime .

<#period>
    a tss:ContextField ;
    rdfs:label "Period as written in the file"@en ;
    tss:columnName "TIME_PERIOD" ;
    tss:datatype xsd:string .

<#value>
    a tss:ValueField ;
    rdfs:label "Deaths"@en ;
    tss:columnName "OBS_VALUE" ;
    tss:datatype xsd:integer ;
    # Belgium (Wikidata)
    tss:featureOfInterest <http://www.wikidata.org/entity/Q31> ;
    tss:unit unit:NUM .

# The flag of Eurostat on a value, such as p (provisional), e (estimated) or b (a break in the series).
<#flag>
    a tss:ContextField ;
    rdfs:label "Flag"@en ;
    rdfs:comment "The flag of Eurostat on the value: b is a break in the time series, c confidential, d a definition that differs, e estimated, p provisional, u of low reliability, z not applicable."@en ;
    tss:columnName "OBS_FLAG" ;
    tss:datatype xsd:string ;
    tss:describesField <#value> .
