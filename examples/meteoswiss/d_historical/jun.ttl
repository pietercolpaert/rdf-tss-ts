@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# The daily weather at Jungfraujoch (VS, 3571 m), from the
# automatic weather stations of MeteoSwiss: d_historical of the station, a static CSV file on
# data.geo.admin.ch. This document only describes it. Written by scripts/meteoswiss.ts.
#
# The file has one row per day, without gaps, so the time of a row is its step on a time grid of
# P1D from 1933-01-01T00:00:00Z: the reference_timestamp column (in UTC) is not read as the time. A
# year of rows is added to the file every January.
<#source>
    a tss:CSVSource ;
    rdfs:label "Daily weather, Jungfraujoch"@en ;
    rdfs:comment "Measurements of the automatic weather station Jungfraujoch of MeteoSwiss, at 3571 m above sea level, one row per day."@en ;
    dcterms:publisher <https://www.meteoswiss.admin.ch> ;
    dcterms:source <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    tss:from "1933-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://data.geo.admin.ch/ch.meteoschweiz.ogd-smn/jun/ogd-smn_jun_d_historical.csv> ;
    tss:delimiter ";" ;
    tss:timeBase "1933-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "P1D"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#reference_timestamp>,
        <#tre200d0>,
        <#tre200dn>,
        <#tre200dx>,
        <#ure200d0>,
        <#prestad0>,
        <#fkl010d0>,
        <#gre000d0>,
        <#sre000d0> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:ContextField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#reference_timestamp>
    a tss:ContextField ;
    rdfs:label "Time as written in the file"@en ;
    rdfs:comment "The start of the day, in UTC, as DD.MM.YYYY hh:mm: not an xsd:dateTime, so not the time of the row."@en ;
    tss:columnName "reference_timestamp" ;
    tss:datatype xsd:string .

<#tre200d0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/jun> ;
    rdfs:label "Air temperature 2 m above ground; daily mean"@en ;
    tss:columnName "tre200d0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:DEG_C .

<#tre200dn>
    a tss:ContextField ;
    tss:describesField <#tre200d0> ;
    tss:property schema:minValue ;
    rdfs:label "Air temperature 2 m above ground; daily minimum"@en ;
    tss:columnName "tre200dn" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:DEG_C .

<#tre200dx>
    a tss:ContextField ;
    tss:describesField <#tre200d0> ;
    tss:property schema:maxValue ;
    rdfs:label "Air temperature 2 m above ground; daily maximum"@en ;
    tss:columnName "tre200dx" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:DEG_C .

<#ure200d0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/jun> ;
    rdfs:label "Relative air humidity 2 m above ground; daily mean"@en ;
    tss:columnName "ure200d0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:PERCENT .

<#prestad0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/jun> ;
    rdfs:label "Atmospheric pressure at barometric altitude (QFE); daily mean"@en ;
    tss:columnName "prestad0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:HectoPA .

<#fkl010d0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/jun> ;
    rdfs:label "Wind speed scalar; daily mean in m/s"@en ;
    tss:columnName "fkl010d0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:M-PER-SEC .

<#gre000d0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/jun> ;
    rdfs:label "Global radiation; daily mean"@en ;
    tss:columnName "gre000d0" ;
    tss:datatype xsd:integer ;
    tss:unit unit:W-PER-M2 .

<#sre000d0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/jun> ;
    rdfs:label "Sunshine duration; daily total"@en ;
    tss:columnName "sre000d0" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MIN .
