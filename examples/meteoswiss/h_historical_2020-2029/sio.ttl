@prefix tss: <https://w3id.org/tss#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# The hourly weather at Sion (VS, 482 m), from the
# automatic weather stations of MeteoSwiss: h_historical_2020-2029 of the station, a static CSV file on
# data.geo.admin.ch. This document only describes it. Written by scripts/meteoswiss.ts.
#
# The file has one row per hour, without gaps, so the time of a row is its step on a time grid of
# PT1H from 2020-01-01T00:00:00Z: the reference_timestamp column (in UTC) is not read as the time. A
# year of rows is added to the file every January.
<#source>
    a tss:CSVSource ;
    rdfs:label "Hourly weather since 2020, Sion"@en ;
    rdfs:comment "Measurements of the automatic weather station Sion of MeteoSwiss, at 482 m above sea level, one row per hour."@en ;
    dcterms:publisher <https://www.meteoswiss.admin.ch> ;
    dcterms:source <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    tss:from "2020-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://data.geo.admin.ch/ch.meteoschweiz.ogd-smn/sio/ogd-smn_sio_h_historical_2020-2029.csv> ;
    tss:delimiter ";" ;
    tss:timeBase "2020-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:timeStep "PT1H"^^xsd:duration ;
    tss:timeField <#time> ;
    tss:hasField <#time>,
        <#reference_timestamp>,
        <#tre200h0>,
        <#tre200hn>,
        <#tre200hx>,
        <#ure200h0>,
        <#prestah0>,
        <#fkl010h0>,
        <#rre150h0>,
        <#gre000h0>,
        <#sre000h0> .

# The time field: computed from the position of the row, so it has no column.
<#time>
    a tss:ContextField ;
    rdfs:label "Time"@en ;
    tss:datatype xsd:dateTime .

<#reference_timestamp>
    a tss:ContextField ;
    rdfs:label "Time as written in the file"@en ;
    rdfs:comment "The start of the hour, in UTC, as DD.MM.YYYY hh:mm: not an xsd:dateTime, so not the time of the row."@en ;
    tss:columnName "reference_timestamp" ;
    tss:datatype xsd:string .

<#tre200h0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/sio> ;
    rdfs:label "Air temperature 2 m above ground; hourly mean"@en ;
    tss:columnName "tre200h0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:DEG_C .

<#tre200hn>
    a tss:ContextField ;
    tss:describesField <#tre200h0> ;
    tss:property schema:minValue ;
    rdfs:label "Air temperature 2 m above ground; hourly minimum"@en ;
    tss:columnName "tre200hn" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:DEG_C .

<#tre200hx>
    a tss:ContextField ;
    tss:describesField <#tre200h0> ;
    tss:property schema:maxValue ;
    rdfs:label "Air temperature 2 m above ground; hourly maximum"@en ;
    tss:columnName "tre200hx" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:DEG_C .

<#ure200h0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/sio> ;
    rdfs:label "Relative air humidity 2 m above ground; hourly mean"@en ;
    tss:columnName "ure200h0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:PERCENT .

<#prestah0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/sio> ;
    rdfs:label "Atmospheric pressure at barometric altitude (QFE); hourly mean"@en ;
    tss:columnName "prestah0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:HectoPA .

<#fkl010h0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/sio> ;
    rdfs:label "Wind speed scalar; hourly mean in m/s"@en ;
    tss:columnName "fkl010h0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:M-PER-SEC .

<#rre150h0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/sio> ;
    rdfs:label "Precipitation; hourly total"@en ;
    tss:columnName "rre150h0" ;
    tss:datatype xsd:decimal ;
    tss:unit unit:MilliM .

<#gre000h0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/sio> ;
    rdfs:label "Global radiation; hourly mean"@en ;
    tss:columnName "gre000h0" ;
    tss:datatype xsd:integer ;
    tss:unit unit:W-PER-M2 .

<#sre000h0>
    a tss:ValueField ;
    tss:featureOfInterest <https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items/sio> ;
    rdfs:label "Sunshine duration; hourly total"@en ;
    tss:columnName "sre000h0" ;
    tss:datatype xsd:integer ;
    tss:unit unit:MIN .
